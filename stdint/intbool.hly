define yesint
    stash num(x)
 when num(x) == yes doit
        !#inclib %strings.yl%

        stash <12truemsg> == "12 is true"
        string_repeat(<12truemsg>, 3)
    done
done

define noint
    stash num(x)
    when num(x) == no doit
        !#inclib %strings.yl%
        
        stash <12falsemsg> == "12 is false"
        string_repeat(<12falsemsg>, 3)
    done
done

