define imint(out, in)
    when in > out doit
        errstate <^ "Input has more characters!"
    else
        errstate <^ "Output has more characters!"
    done
done

define zint(orr, irr)
    when irr == 0 doit
    else
        errstate <^ "An error has occured in <input_lib> input"
    done
    
    when orr == 0 doit
    else
        errstate <^ "An error has occured in <input_lib>"
    done
done