define graph_lining(x, y, z)
    writescrn <^ xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    writescrn <^ xxxxxyyyxxxxyyyyyyxxxxxxxyyyyyyxxxx
    writescrn <^ xxxyyxxxyyxyxxxxxyxxxxxxyxxxxxyxxxx
    writescrn <^ xxxyyyyyyyxyxxxxxyxxxxxxyxxxxxyxxxx
    writescrn <^ xxxyxxxxxyxyxxxxxyxxxxxxyxxxxxyxxxx
    writescrn <^ xxxyxxxxxyxyxxxxxyxxxxxxyxxxxxyxxxx
    writescrn <^ xxxyxxxxxyxxyyyyyxxxxxxxxyyyyyxxxxx
    done
done

define graphing_table
    stash table == "8,16,32"
    when table == 0 doit
        errstate <^ "Table is not responding, cannot execute script!"
    done
done
