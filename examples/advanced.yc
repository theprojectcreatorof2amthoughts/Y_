## Advanced Y_ runtime utilities, using the existing Y_ vocabulary.

stash phrase = "Y_ keeps its identity"
writescrn >^ "Original phrase: " .. phrase
writescrn >^ "Starts with Y_: " .. tostring(startswith(phrase, "Y_"))
writescrn >^ "Ends with identity: " .. tostring(endswith(phrase, "identity"))
writescrn >^ "Contains keeps: " .. tostring(contains(phrase, "keeps"))
writescrn >^ "Substring: " .. substring(phrase, 0, 3)
writescrn >^ "Last character: " .. charat(phrase, -1)
writescrn >^ "Replace: " .. replace(phrase, "identity", "its own vocabulary")
writescrn >^ "Repeat: " .. repeat("Y_", 3)
writescrn >^ "Reverse: " .. reverse("Y_language")

writescrn >^ "Sum: " .. tostring(sum(10, 20, 30, 40))
writescrn >^ "Average: " .. tostring(average(10, 20, 30, 40))
writescrn >^ "Hypotenuse: " .. tostring(hypot(3, 4))
writescrn >^ "90 degrees in radians: " .. tostring(radians(90))
writescrn >^ "Pi in degrees: " .. tostring(degrees(3.141592653589793))
writescrn >^ "Angle from (1, 1): " .. tostring(degrees(atan2(1, 1)))
writescrn >^ "Finite result: " .. tostring(isfinite(sqrt(81)))
writescrn >^ "NaN check: " .. tostring(isnan(tonumber("nan")))
