## 2D vector helpers. Components are passed as separate numbers.

define model_vec2_dot(ax, ay, bx, by)
    give ax * bx + ay * by
done

define model_vec2_add_x(ax, bx)
    give ax + bx
done

define model_vec2_add_y(ay, by)
    give ay + by
done

define model_vec2_sub_x(ax, bx)
    give ax - bx
done

define model_vec2_sub_y(ay, by)
    give ay - by
done

define model_vec2_scale_x(x, amount)
    give x * amount
done

define model_vec2_scale_y(y, amount)
    give y * amount
done

define model_vec2_length_squared(x, y)
    give x * x + y * y
done

define model_vec2_distance_squared(ax, ay, bx, by)
    stash dx = bx - ax
    stash dy = by - ay
    give dx * dx + dy * dy
done

define model_vec2_cross(ax, ay, bx, by)
    give ax * by - ay * bx
done

define model_vec2_perpendicular_x(x, y)
    give -y
done

define model_vec2_perpendicular_y(x, y)
    give x
done

define model_vec2_lerp(start, finish, amount)
    give start + (finish - start) * amount
done
