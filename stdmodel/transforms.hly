## Component-wise transforms for points and directions.
## These helpers use scale and translation; no matrix or vector object is required.

define model_point_translate_x(x, offset)
    give x + offset
done

define model_point_translate_y(y, offset)
    give y + offset
done

define model_point_translate_z(z, offset)
    give z + offset
done

define model_point_scale_x(x, amount)
    give x * amount
done

define model_point_scale_y(y, amount)
    give y * amount
done

define model_point_scale_z(z, amount)
    give z * amount
done

define model_point_scale_about_pivot(point, pivot, amount)
    give pivot + (point - pivot) * amount
done

define model_remap(value, input_start, input_end, output_start, output_end)
    when input_end == input_start doit
        give output_start
    else
        give output_start + (value - input_start) * (output_end - output_start) / (input_end - input_start)
    done
done

define model_clamp(value, low, high)
    when value < low doit
        give low
    else
        when value > high doit
            give high
        else
            give value
        done
    done
done
